{
  "name": "photo-vault",
  "version": "0.1.1",
  "private": true,
  "description": "相册收集站 · 本地优先的照片收集与整理工具",
  "main": "./out/main/index.js",
  "author": "PhotoVault",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "seed": "node test/seed.cjs",
    "e2e": "node test/e2e.mjs",
    "e2e:full": "node test/seed.cjs && node test/run.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "zustand": "^5.1.0"
  },
  "//overrides": "electron-builder 26.18 的 app-builder-lib 用到了 @electron/get 4.x 的 ElectronDownloadCacheMode，但依赖声明写的是 ^3.0.0（3.x 只有 CacheMode），干净安装必然报 Cannot read properties of undefined (reading 'ReadWrite')。只给 app-builder-lib 这一支钉到 4.0.3，electron 自己的 5.x 不动。",
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "4.0.3"
    }
  },
  "pnpm": {
    "overrides": {
      "app-builder-lib>@electron/get": "4.0.3"
    }
  }
}
